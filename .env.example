# Shelby API Key — obtain from docs.shelby.xyz/sdks/typescript/acquire-api-keys
NEXT_PUBLIC_SHELBY_API_KEY=

# Aptos API Key — obtain from Aptos developer portal
NEXT_PUBLIC_APTOS_API_KEY=

# Network — must be "testnet" for Shelby Early Access
NEXT_PUBLIC_APTOS_NETWORK=testnet

# Shelby Testnet RPC base URL (do not change unless Shelby changes it)
NEXT_PUBLIC_SHELBY_RPC_URL=https://api.testnet.shelby.xyz

# Shelby Explorer base URL
NEXT_PUBLIC_SHELBY_EXPLORER_URL=https://explorer.shelby.xyz/testnet
