# Shelby API Key — obtain from docs.shelby.xyz/sdks/typescript/acquire-api-keys
NEXT_PUBLIC_SHELBY_API_KEY=

# Aptos API Key — obtain from Aptos developer portal
NEXT_PUBLIC_APTOS_API_KEY=

# Shelbynet currently reports chain ID 118.
NEXT_PUBLIC_SHELBY_CHAIN_ID=118

# Shelby RPC base URL
NEXT_PUBLIC_SHELBY_RPC_URL=https://api.shelbynet.shelby.xyz/shelby

# Shelby Explorer base URL
NEXT_PUBLIC_SHELBY_EXPLORER_URL=https://explorer.shelby.xyz/shelbynet
